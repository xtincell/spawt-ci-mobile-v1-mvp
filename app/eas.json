{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_DEMO_MODE": "true"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_SUPABASE_URL": "https://api.spawt.online",
        "EXPO_PUBLIC_SUPABASE_ANON_KEY": "eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.eyJpc3MiOiJzdXBhYmFzZSIsImlhdCI6MTc4MzI4NzAwMCwiZXhwIjo0OTM4OTYwNjAwLCJyb2xlIjoiYW5vbiJ9.4il9S43L-oBixQiKabl6a5sl4B9CbLWqH-pK32dWtu0"
      }
    },
    "production": {
      "channel": "production",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_SUPABASE_URL": "https://api.spawt.online",
        "EXPO_PUBLIC_SUPABASE_ANON_KEY": "eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.eyJpc3MiOiJzdXBhYmFzZSIsImlhdCI6MTc4MzI4NzAwMCwiZXhwIjo0OTM4OTYwNjAwLCJyb2xlIjoiYW5vbiJ9.4il9S43L-oBixQiKabl6a5sl4B9CbLWqH-pK32dWtu0"
      }
    },
    "preview-ios-device": {
      "extends": "preview",
      "distribution": "internal",
      "channel": "preview",
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_SUPABASE_URL": "https://api.spawt.online",
        "EXPO_PUBLIC_SUPABASE_ANON_KEY": "eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.eyJpc3MiOiJzdXBhYmFzZSIsImlhdCI6MTc4MzI4NzAwMCwiZXhwIjo0OTM4OTYwNjAwLCJyb2xlIjoiYW5vbiJ9.4il9S43L-oBixQiKabl6a5sl4B9CbLWqH-pK32dWtu0"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "REMPLACER_ASC_APP_ID",
        "appleTeamId": "REMPLACER_APPLE_TEAM_ID"
      },
      "android": {
        "serviceAccountKeyPath": "./secrets/play-service-account.json",
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
