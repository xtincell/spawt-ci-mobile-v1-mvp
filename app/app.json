{
  "expo": {
    "name": "SPAWT",
    "slug": "spawt-mobile-ci",
    "version": "1.1.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "spawt",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "runtimeVersion": {
      "policy": "nativeVersion"
    },
    "updates": {
      "enabled": true,
      "url": "https://u.expo.dev/15ac2301-e901-4caa-a8c8-864c6621bcd0",
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.upgraders.spawt",
      "buildNumber": "17",
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "SPAWT a besoin de ta position pour valider tes spawts dans les lieux que tu visites. Tu actives la g\u00e9oloc seulement quand tu es au resto. Plus de d\u00e9tails dans la politique de confidentialit\u00e9.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Pour d\u00e9tecter tes spawts en arri\u00e8re-plan quand tu es proche d'un lieu. Optionnel \u2014 d\u00e9sactivable \u00e0 tout moment.",
        "NSCameraUsageDescription": "Pour ajouter une photo \u00e0 ton avis sur un lieu. Toujours optionnel."
      }
    },
    "android": {
      "package": "com.upgraders.spawt",
      "versionCode": 22,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0A0A"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES"
      ],
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-apple-authentication",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Pour d\u00e9tecter tes spawts en arri\u00e8re-plan."
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/window-repere.png",
          "imageWidth": 285,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "android": {
            "drawable": {
              "icon": "./assets/brand/window-repere.android.xml"
            }
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#C8A44E"
        }
      ],
      "@maplibre/maplibre-react-native",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Pour choisir ta photo de profil dans ta galerie.",
          "cameraPermission": "Pour prendre ta photo de profil."
        }
      ]
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "15ac2301-e901-4caa-a8c8-864c6621bcd0"
      },
      "buildDate": ""
    },
    "owner": "xtincell",
    "androidStatusBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#FFFFFF"
    }
  }
}
